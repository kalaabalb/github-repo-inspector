# Optional. AI explanations remain unavailable when this is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Comma-separated browser origins. Replace local origins with the deployed
# Flutter Web origin when the API is deployed. Do not use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5000,http://127.0.0.1:8080
